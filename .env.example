
# Turso database (used by the app at runtime and by `bun run db:push`)
DATABASE_URL="libsql://your-database.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Optional: local SQLite file used by Prisma CLI commands (migrate, studio, ...).
# Defaults to file:./dev.db when not set.
# PRISMA_DATABASE_URL="file:./dev.db"
